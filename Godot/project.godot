[layer_names]

2d_physics/layer_1="Default"
2d_physics/layer_9="ClickArea"

[locale]

translations=PackedStringArray("res://Localization/English.en.translation", "res://Localization/Russian.ru.translation")

[mono]

project/assembly_name="Soteo"

[network]

limits/webrtc/max_channel_in_buffer_kb=100000
limits/websocket_client/max_in_buffer_kb=100000
limits/websocket_client/max_out_buffer_kb=100000
limits/websocket_server/max_in_buffer_kb=100000
limits/websocket_server/max_out_buffer_kb=100000

[physics]

common/physics_ticks_per_second=20

[rendering]

environment/defaults/default_clear_color=Color(0.0313726, 0.0431373, 0.0784314, 1)
environment/defaults/default_environment="res://default_env.tres"
quality/driver/driver_name="GLES2"
vram_compression/import_etc=true
